{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch Carnatic notation",
      "type": "npm",
      "script": "validate:notation:watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "external",
        "source": "Carnatic notation",
        "severity": "error",
        "applyTo": "allDocuments",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+) - error (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Watching Carnatic notation$",
          "endsPattern": "^Notation validation ready$"
        }
      },
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
