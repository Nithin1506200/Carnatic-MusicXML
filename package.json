{
  "name": "swara-adhyaaya",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "ragas:generate": "node --import tsx scripts/generate-ragas.ts",
    "content": "npm run --silent ragas:generate && node --import tsx scripts/generate-content.mjs",
    "validate:notation": "npm run --silent ragas:generate && node --import tsx scripts/validate-notation.ts",
    "validate:notation:watch": "npm run --silent ragas:generate && node --import tsx scripts/validate-notation.ts --watch",
    "mscz:generate": "npm run --silent ragas:generate && node --import tsx scripts/carnatic-to-mscz.ts",
    "predev": "npm run content",
    "dev": "vite",
    "prebuild": "npm run validate:notation && npm run content",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "npm run --silent ragas:generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"README.md\" \"AGENTS.md\" \"docs/**/*.{md,mdx}\" \"scores/**/*.{md,mdx}\" && node scripts/format-notation-text.mjs",
    "format:check": "prettier --check \"README.md\" \"AGENTS.md\" \"docs/**/*.{md,mdx}\" \"scores/**/*.{md,mdx}\" && node scripts/format-notation-text.mjs --check",
    "format:md": "prettier --write \"README.md\" \"AGENTS.md\" \"docs/**/*.md\" \"scores/**/*.md\"",
    "format:md:check": "prettier --check \"README.md\" \"AGENTS.md\" \"docs/**/*.md\" \"scores/**/*.md\"",
    "format:mdx": "prettier --write \"scores/**/*.mdx\" && node scripts/format-notation-text.mjs",
    "format:mdx:check": "prettier --check \"scores/**/*.mdx\" && node scripts/format-notation-text.mjs --check",
    "prelint": "npm run content",
    "lint": "eslint ."
  },
  "dependencies": {
    "fflate": "^0.7.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "webmscore": "^1.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.4.0",
    "prettier": "^3.9.6",
    "smol-toml": "^1.8.0",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "8.2.1",
    "vitest": "^4.1.10",
    "yaml": "^2.8.1"
  },
  "type": "module"
}
